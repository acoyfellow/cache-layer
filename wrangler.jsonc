{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cache-layer",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
